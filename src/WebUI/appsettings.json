{
    "UseInMemoryDatabase": true,
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ArrayAppDb;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=true;TrustServerCertificate=true"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "IdentityServer": {
        "Clients": {
            "ArrayApp.WebUI": {
                "Profile": "IdentityServerSPA"
            }
        }
    },
    "AllowedHosts": "localhost;127.0.0.1",
    "Authentication": {
        "JwtBearer": {
            "SecurityKey": "ArrayAppEnterpriseSecretKeyWith256BitsMinimumLength2026!",
            "Issuer": "ArrayApp.WebUI.Issuer",
            "Audience": "ArrayApp.WebUI.Audience",
            "TokenDurationInSeconds": 3600
        }
    }
}
